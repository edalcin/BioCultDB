<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> - BioCultDB</title>
  <link rel="stylesheet" href="/styles/main.css">
  <script src="https://unpkg.com/alpinejs@3.13.3" defer></script>
  <script src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
  <script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
  </script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="min-h-screen bg-gray-50" x-data="extracaoIA()">

  <!-- Settings Modal -->
  <%- include('partials/extraction-settings') %>

  <!-- Header -->
  <header class="bg-forest-700 text-white shadow-lg">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center gap-4">
        <img src="/images/logo.png" alt="BioCultDB Logo" class="h-16 w-16">
        <div>
          <h1 class="text-2xl font-bold"><%= contextName %></h1>
          <p class="text-forest-100 text-sm"><%= contextDescription %></p>
        </div>
      </div>
    </div>
  </header>

  <!-- Navigation -->
  <nav class="bg-forest-600 text-white border-b border-forest-800">
    <div class="container mx-auto px-4">
      <ul class="flex gap-0">
        <li>
          <a href="/" class="block px-6 py-2 hover:bg-forest-700 transition-colors border-b-2 border-transparent hover:border-forest-300 text-sm">
            Entrada de Dados
          </a>
        </li>
        <li>
          <a href="/extraction-prompt" class="block px-6 py-2 hover:bg-forest-700 transition-colors border-b-2 border-transparent hover:border-forest-300 text-sm">
            Prompt de Extração
          </a>
        </li>
        <li x-data="{ ok: !!JSON.parse(localStorage.getItem('extracao_settings')||'null')?.apiKey }"
            x-on:extracao-settings-changed.window="ok = !!JSON.parse(localStorage.getItem('extracao_settings')||'null')?.apiKey"
            x-cloak>
          <a href="/extracao-ia"
             :class="ok ? 'block px-6 py-2 hover:bg-forest-700 transition-colors border-b-2 border-forest-400 font-medium text-sm' : 'block px-6 py-2 border-b-2 border-transparent text-sm text-white/40 cursor-not-allowed'"
             :title="ok ? '' : 'Configure uma chave de API para habilitar'">
            Extração por IA
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto space-y-6">

      <!-- Configuration summary -->
      <section class="card flex items-center justify-between">
        <div class="text-sm text-gray-700">
          <template x-if="isConfigured">
            <span>
              Provedor: <strong x-text="providerName"></strong>
              — Modelo: <strong x-text="settings.model"></strong>
            </span>
          </template>
          <template x-if="!isConfigured">
            <span class="text-amber-700">Configure um Provedor de IA e sua chave para começar.</span>
          </template>
        </div>
        <button @click="showSettings = true" class="btn btn-secondary">
          Configurar
        </button>
      </section>

      <!-- Extraction form -->
      <section class="card">
        <h2 class="text-xl font-semibold text-gray-900 mb-2">Texto do Artigo</h2>
        <p class="text-sm text-gray-600 mb-4">
          Selecione um PDF (lido inteiramente no navegador — o arquivo nunca é enviado ao servidor) ou
          cole o texto de um artigo científico. Ao final, uma Evidência <strong>pendente</strong> é
          gravada e aparece na Curadoria — mesmo que a extração venha incompleta.
        </p>

        <div class="flex items-center gap-3 mb-4">
          <label class="btn btn-secondary cursor-pointer" :class="{ 'opacity-50 pointer-events-none': isBusy }">
            Selecionar PDF
            <input type="file" accept="application/pdf,.pdf" class="hidden" @change="selecionarArquivo($event)" :disabled="isBusy">
          </label>
          <span class="text-sm text-gray-600" x-show="arquivoNome" x-text="'Extraído de: ' + arquivoNome"></span>
        </div>

        <textarea
          x-model="texto"
          rows="16"
          placeholder="Cole aqui o texto do artigo científico..."
          class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-forest-500 focus:border-forest-500"
          :disabled="isBusy"
        ></textarea>

        <div class="flex justify-end mt-4">
          <button
            @click="extrair"
            :disabled="!isConfigured || !texto.trim() || isBusy"
            class="btn btn-primary flex items-center gap-2"
          >
            <template x-if="isBusy">
              <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </template>
            <span x-text="isBusy ? 'Extraindo...' : 'Extrair'"></span>
          </button>
        </div>
      </section>

      <!-- Progress -->
      <section class="card bg-blue-50 border border-blue-200" x-show="phase === 'lendo-pdf' || phase === 'consultando' || phase === 'salvando'">
        <div class="flex items-center gap-3 text-blue-800">
          <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span x-show="phase === 'lendo-pdf'">Lendo PDF...</span>
          <span x-show="phase === 'consultando'">Consultando a IA...</span>
          <span x-show="phase === 'salvando'">Salvando a Evidência...</span>
        </div>
      </section>

      <!-- Error -->
      <section class="card bg-red-50 border border-red-200" x-show="phase === 'erro'">
        <p class="text-red-800 mb-3" x-text="errorMessage"></p>
        <button @click="extrair" class="btn btn-secondary">
          Tentar Novamente
        </button>
      </section>

      <!-- Success -->
      <section class="card bg-green-50 border border-green-200" x-show="phase === 'sucesso'">
        <p class="text-green-800 mb-3">
          Evidência pendente gravada. Ela já aparece na Curadoria.
        </p>
        <div class="flex gap-3">
          <a :href="curadoriaUrl" target="_blank" class="btn btn-primary">
            Ver na Curadoria
          </a>
          <button @click="novaExtracao" class="btn btn-secondary">
            Nova Extração
          </button>
        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-white py-6 mt-12">
    <div class="container mx-auto px-4 text-center">
      <p class="text-sm">BioCultDB - Base de Dados Etnobotânica</p>
      <p class="text-xs text-gray-400 mt-1">Eduardo Dalcin - 2025/2026</p>
      <p class="text-xs text-gray-400">
        <a href="https://github.com/edalcin/BioCultDB" target="_blank" class="hover:text-forest-300">https://github.com/edalcin/BioCultDB</a>
      </p>
    </div>
  </footer>

  <!-- Extração por IA JavaScript -->
  <script src="/scripts/pdf-text.js"></script>
  <script src="/scripts/extraction.js"></script>

</body>
</html>
